---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.data.slug ?? post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---
<BaseLayout title={post.data.title} description={post.data.description} activeNav="blog">
  <div class="container">
    <div class="post-header">
      <div class="post-header__meta">
        <span>{formatDate(post.data.date)}</span>
        {post.data.lang === 'cs' && (
          <span class="post-header__lang-badge">Czech</span>
        )}
      </div>
      <h1>{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <div class="tags" style="margin-top:1rem;">
          {post.data.tags.map(t => <span class="tag">{t}</span>)}
        </div>
      )}
    </div>

    <article class="prose">
      <Content />
    </article>

    <p style="margin-top:3rem;font-size:.875rem;border-top:1px solid var(--border);padding-top:1.5rem;">
      <a href="/blog">← All posts</a>
    </p>
  </div>
</BaseLayout>
