---
import BaseLayout from '../layouts/BaseLayout.astro';
import { load as yamlLoad } from 'js-yaml';
import { readFileSync } from 'fs';
import { fileURLToPath } from 'url';
import path from 'path';

// Load timeline data
const timelineRaw = readFileSync(
  path.join(process.cwd(), 'src/data/timeline.yaml'),
  'utf-8'
);

interface TimelineEntry {
  year: number;
  type: 'career' | 'education' | 'project' | 'event';
  title: string;
  description: string;
  company?: string;
  start?: string;
  end?: string;
  url?: string;
  github?: string;
  image?: string;
}

const timeline = (yamlLoad(timelineRaw) as TimelineEntry[]).reverse(); // newest first

// Group by year
const byYear = timeline.reduce<Record<number, TimelineEntry[]>>((acc, entry) => {
  if (!acc[entry.year]) acc[entry.year] = [];
  acc[entry.year].push(entry);
  return acc;
}, {});

const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);

// Flatten into a list with year separators for alternating layout
interface TimelineItem {
  kind: 'year' | 'entry';
  year: number;
  entry?: TimelineEntry;
  index: number; // running entry index for left/right alternation
}

const items: TimelineItem[] = [];
let entryIndex = 0;
for (const year of years) {
  items.push({ kind: 'year', year, index: 0 });
  for (const entry of byYear[year]) {
    items.push({ kind: 'entry', year, entry, index: entryIndex });
    entryIndex++;
  }
}

const typeLabel: Record<string, string> = {
  career: 'career',
  education: 'education',
  project: 'project',
  event: 'event',
};
---
<BaseLayout title="Timeline" activeNav="timeline">
  <div class="container--wide">
    <div class="page-hero">
      <p class="page-hero__eyebrow">history</p>
      <h1 class="page-hero__title">Timeline</h1>
      <p class="page-hero__subtitle">
        {new Date().getFullYear() - 2004} years of building things — career, projects, and milestones.
      </p>
    </div>


    <div class="timeline">
      {items.map(item => item.kind === 'year' ? (
        <div class="timeline-year-bubble">{item.year}</div>
      ) : (
        <div class={`timeline-entry timeline-entry--${item.entry!.type} ${item.index % 2 === 0 ? 'timeline-entry--right' : 'timeline-entry--left'}`}>
          <div class="timeline-dot"></div>
          <div class="timeline-card">
            <div class="timeline-card__arrow"></div>
            <div class="timeline-entry__title">{item.entry!.title}</div>
            <div class="timeline-entry__subtitle">
              <span class="timeline-entry__meta">
                {typeLabel[item.entry!.type]}
                {item.entry!.start && item.entry!.end && ` · ${item.entry!.start} – ${item.entry!.end}`}
              </span>
              {item.entry!.company && (
                <span class="timeline-entry__company">· {item.entry!.company}</span>
              )}
            </div>
            <div class="timeline-entry__desc">{item.entry!.description}</div>
            {(item.entry!.url || item.entry!.github) && (
              <div class="timeline-entry__links">
                {item.entry!.url && (
                  <a class="timeline-entry__link" href={item.entry!.url} target="_blank" rel="noopener">
                    ↗ {new URL(item.entry!.url).hostname}
                  </a>
                )}
                {item.entry!.github && (
                  <a class="timeline-entry__link" href={item.entry!.github} target="_blank" rel="noopener">
                    ↗ github
                  </a>
                )}
              </div>
            )}
            {item.entry!.image && (
              <img class="timeline-entry__image" src={item.entry!.image} alt={item.entry!.title} loading="lazy" />
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
